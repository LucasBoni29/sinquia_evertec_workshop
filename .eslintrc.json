{
  "env": {
    "browser": true,
    "es6": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "script"
  },
  "rules": {
    "indent": "off",
    "linebreak-style": "off",
    "quotes": "off",
    "semi": "off",
    "no-console": "warn",
    "no-unused-vars": "warn",
    "no-undef": "error",
    "prefer-const": "error",
    "no-var": "error",
    "no-useless-escape": "off"
  },
  "globals": {
    "fetch": "readonly",
    "console": "readonly",
    "document": "readonly",
    "window": "readonly",
    "setTimeout": "readonly",
    "clearTimeout": "readonly"
  }
}
